<Window x:Class="GlassBar.TopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GlassBar.Controls"
        Title="GlassBar widgets" Width="620" Height="54" MinWidth="150" MinHeight="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="#F8FAFC"
        AutomationProperties.AutomationId="TopOverlayWindow">
  <Window.Resources>
    <SolidColorBrush x:Key="TopGlassBackground" Color="#111722" Opacity="0.82" />
    <SolidColorBrush x:Key="TopAccent" Color="#7DD3FC" />
    <Style x:Key="WidgetDivider" TargetType="Border">
      <Setter Property="Width" Value="1" /><Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="9,0" /><Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="WidgetLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9FB0C5" /><Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="WidgetValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F8FAFC" /><Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Border x:Name="TopSurface" Margin="4" CornerRadius="18"
          Background="{DynamicResource TopGlassBackground}" BorderBrush="#30FFFFFF" BorderThickness="1"
          PreviewMouseLeftButtonDown="TopSurface_PreviewMouseLeftButtonDown">
    <Border.Effect><DropShadowEffect x:Name="TopShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.42" Color="#020617" /></Border.Effect>
    <Grid>
      <controls:AmbientEffect x:Name="TopEffectsLayer" />
      <Rectangle x:Name="TopHighlight" VerticalAlignment="Top" Height="1" Margin="18,0" Fill="#70FFFFFF" Opacity="0.26" />
      <StackPanel x:Name="TopWidgetsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,6">
        <TextBlock x:Name="TopDragHandle" Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#68FFFFFF"
                   Width="20" VerticalAlignment="Center" TextAlignment="Center" ToolTip="Drag widget bar" Cursor="SizeAll" />
        <StackPanel x:Name="ClockWidget" Width="92">
          <TextBlock x:Name="TopClockText" Style="{StaticResource WidgetValue}" Text="9:41" />
          <TextBlock x:Name="TopDateText" Style="{StaticResource WidgetLabel}" Text="MON, SEP 15" />
        </StackPanel>
        <StackPanel x:Name="PerformanceWidget" Orientation="Horizontal">
          <Border x:Name="PerformanceDivider" Style="{StaticResource WidgetDivider}" />
          <StackPanel x:Name="PerformanceContent" Width="112"><TextBlock Style="{StaticResource WidgetLabel}" Text="SYSTEM · PRO" /><TextBlock x:Name="PerformanceText" Style="{StaticResource WidgetValue}" Text="CPU 0% · RAM 0%" /></StackPanel>
        </StackPanel>
        <StackPanel x:Name="ConnectionWidget" Orientation="Horizontal">
          <Border x:Name="ConnectionDivider" Style="{StaticResource WidgetDivider}" />
          <StackPanel x:Name="ConnectionContent" Width="86"><TextBlock Style="{StaticResource WidgetLabel}" Text="CONNECTION" /><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="#34D399" /><TextBlock x:Name="ConnectionText" Style="{StaticResource WidgetValue}" Text="Online" /></StackPanel></StackPanel>
        </StackPanel>
        <StackPanel x:Name="PowerWidget" Orientation="Horizontal">
          <Border x:Name="PowerDivider" Style="{StaticResource WidgetDivider}" />
          <StackPanel x:Name="PowerContent" Width="105"><TextBlock Style="{StaticResource WidgetLabel}" Text="POWER · PRO" /><TextBlock x:Name="PowerText" Style="{StaticResource WidgetValue}" Text="Desktop" TextTrimming="CharacterEllipsis" /></StackPanel>
        </StackPanel>
        <StackPanel x:Name="FocusWidget" Orientation="Horizontal">
          <Border x:Name="FocusDivider" Style="{StaticResource WidgetDivider}" />
          <Button x:Name="FocusButton" Width="112" Height="32" Click="FocusButton_Click" Cursor="Hand" Background="#12FFFFFF" BorderThickness="0" ToolTip="Start or reset the focus timer" AutomationProperties.AutomationId="FocusTimerButton">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="FocusSurface" Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="10,5">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource TopAccent}" /><TextBlock x:Name="FocusText" Text="Focus 25" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" /></StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusSurface" Property="Background" Value="#22FFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="FocusSurface" Property="Opacity" Value="0.74" /></Trigger></ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
        <StackPanel x:Name="NewsWidget" Orientation="Horizontal">
          <Border x:Name="NewsDivider" Style="{StaticResource WidgetDivider}" />
          <Button x:Name="NewsButton" Width="190" Height="34" Click="NewsButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="Open headline">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="NewsSurface" CornerRadius="9" Background="{TemplateBinding Background}" Padding="4,2">
                  <StackPanel><TextBlock Style="{StaticResource WidgetLabel}" Text="DAILY NEWS" /><TextBlock x:Name="NewsText" Text="Loading headline…" Style="{StaticResource WidgetValue}" FontSize="10" TextTrimming="CharacterEllipsis" /></StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NewsSurface" Property="Background" Value="#18FFFFFF" /></Trigger></ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </StackPanel>
      <Canvas x:Name="TopStickerCanvas" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Window>
