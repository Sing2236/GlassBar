<Window x:Class="GlassBar.SearchPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBar search" Width="620" Height="472"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Opacity="0"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#F8FAFC"
        KeyDown="Window_KeyDown" AutomationProperties.AutomationId="GlassBarSearchPalette">
  <Window.Resources>
    <SolidColorBrush x:Key="PaletteTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="PaletteMutedBrush" Color="#A8B9CA" />
    <SolidColorBrush x:Key="PaletteAccentBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="PaletteAccentSurfaceBrush" Color="#3D7DD3FC" />
    <Style x:Key="ModeButton" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource PaletteMutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#17FFFFFF" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PaletteAccentSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PaletteTextBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaletteResult" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource PaletteTextBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" CornerRadius="11" Padding="10,7" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18FFFFFF" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PaletteAccentSurfaceBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="PaletteSurface" Margin="14" Padding="18" CornerRadius="22"
          Background="#F2111722" BorderBrush="#48FFFFFF" BorderThickness="1"
          RenderTransformOrigin="0.5,0.5">
    <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="10" Opacity="0.58" Color="#020617" /></Border.Effect>
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="PaletteScale" ScaleX="0.97" ScaleY="0.97" />
        <TranslateTransform x:Name="PaletteOffset" Y="12" />
      </TransformGroup>
    </Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Height="52" Background="#17FFFFFF" BorderBrush="#2FFFFFFF" BorderThickness="1" CornerRadius="15">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#AFC5D8"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBox x:Name="QueryBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource PaletteTextBrush}" CaretBrush="{DynamicResource PaletteAccentBrush}" FontSize="16" FontWeight="Medium" Padding="0,0,12,0"
                   VerticalContentAlignment="Center" TextChanged="QueryBox_TextChanged"
                   KeyDown="QueryBox_KeyDown" AutomationProperties.AutomationId="SearchPaletteQuery" />
          <TextBlock x:Name="QueryHint" Grid.Column="1" Foreground="{DynamicResource PaletteMutedBrush}" FontSize="15" FontWeight="Medium"
                     VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
      </Border>

      <DockPanel x:Name="ModePanel" Grid.Row="1" Margin="2,11,2,10">
        <TextBlock x:Name="ResultCount" DockPanel.Dock="Right" Foreground="{DynamicResource PaletteMutedBrush}" FontSize="10" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="AppsModeButton" Style="{StaticResource ModeButton}" Content="Apps  1" Tag="Apps" Click="ModeButton_Click" />
          <ToggleButton x:Name="WebModeButton" Style="{StaticResource ModeButton}" Content="Web  2" Tag="Web" Click="ModeButton_Click" />
          <ToggleButton x:Name="CombinedModeButton" Style="{StaticResource ModeButton}" Content="Combined  3" Tag="Combined" Click="ModeButton_Click" />
        </StackPanel>
      </DockPanel>

      <Grid x:Name="ResultsPanel" Grid.Row="2">
        <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PaletteTextBrush}"
                 ItemContainerStyle="{StaticResource PaletteResult}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                 AutomationProperties.AutomationId="SearchPaletteResults">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                  <Border x:Name="FallbackIcon" Visibility="Collapsed" CornerRadius="9" Background="#1FFFFFFF">
                    <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" Foreground="#AFC5D8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image x:Name="ResultIcon" Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,12,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource PaletteMutedBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Background="#16FFFFFF" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource PaletteTextBrush}" FontSize="9" FontWeight="SemiBold" />
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="ResultIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" /></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="No matching results" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyHint" Text="Try a different search" Foreground="{DynamicResource PaletteMutedBrush}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

      <DockPanel x:Name="FooterPanel" Grid.Row="3" Margin="3,11,3,0">
        <TextBlock x:Name="ModeHotkeyText" Foreground="{DynamicResource PaletteMutedBrush}" FontSize="10" />
        <TextBlock DockPanel.Dock="Right" Text="↑↓ navigate   Enter open   Esc close" Foreground="{DynamicResource PaletteMutedBrush}" FontSize="10" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
