<Window x:Class="GlassBar.AltTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBar window switcher" Width="1320" Height="252"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Opacity="0" FontFamily="Segoe UI Variable Display, Segoe UI"
        AutomationProperties.AutomationId="GlassBarAltTab">
  <Window.Resources>
    <Style x:Key="PreviewCloseButton" TargetType="Button">
      <Setter Property="Width" Value="27" />
      <Setter Property="Height" Value="27" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="#9C0A0E14" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="13.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter TargetName="CloseSurface" Property="Background" Value="#E8C24154" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Opacity" Value="0.65" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Opacity" Value="0.82" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Opacity" Value="0.72" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PreviewCard" TargetType="ListBoxItem">
      <Setter Property="Width" Value="144" />
      <Setter Property="Height" Value="224" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
              <Border x:Name="SelectionBorder" CornerRadius="5" BorderThickness="2"
                      BorderBrush="Transparent" Background="#16000000">
                <ContentPresenter />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#70FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#F4F8FBFF" />
                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="3" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.13" />
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.13" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.11" />
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.11" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="SwitcherSurface" Padding="10" CornerRadius="5"
          Background="#B85C7280" BorderBrush="#55DCE8EE" BorderThickness="1"
          RenderTransformOrigin="0.5,0.5">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.44" Color="#02070B" /></Border.Effect>
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="SurfaceScale" ScaleX="0.99" ScaleY="0.99" />
        <TranslateTransform x:Name="SurfaceTranslate" Y="10" />
      </TransformGroup>
    </Border.RenderTransform>

    <ListBox x:Name="WindowList" Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource PreviewCard}" SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="AltTabWindowList">
      <ListBox.RenderTransform><TranslateTransform x:Name="ListTranslate" /></ListBox.RenderTransform>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ToolTip="{Binding Title}">
            <Border CornerRadius="3" ClipToBounds="True" Background="#DB17212B">
              <Grid>
                <Image Source="{Binding Preview}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Grid x:Name="PreviewFallback" Visibility="Collapsed">
                  <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#5A7483" Offset="0" />
                      <GradientStop Color="#182631" Offset="1" />
                    </LinearGradientBrush>
                  </Grid.Background>
                  <Image Source="{Binding Icon}" Width="44" Height="44" HorizontalAlignment="Center"
                         VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <Button Style="{StaticResource PreviewCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,7,7,0" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Click="CloseWindow_Click" ToolTip="Close window" AutomationProperties.Name="Close window" />
              </Grid>
            </Border>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Preview}" Value="{x:Null}"><Setter TargetName="PreviewFallback" Property="Visibility" Value="Visible" /></DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Border>
</Window>
