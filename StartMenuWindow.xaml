<Window x:Class="GlassBar.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GlassBar.Controls"
        Title="GlassBar menu" Width="660" Height="610"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="#F8FAFC"
        AutomationProperties.AutomationId="GlassBarStartMenu"
        KeyDown="Window_KeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="MenuMuted" Color="#94A3B8" />
    <Style x:Key="MenuAction" TargetType="Button">
      <Setter Property="Foreground" Value="#EAF2FA" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18FFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2AFFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SearchResultItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding IconState}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ResultSurface" Background="{TemplateBinding Background}" CornerRadius="12" Padding="10,7">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ResultSurface" Property="Background" Value="#18FFFFFF" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ResultSurface" Property="Background" Value="#2A7DD3FC" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ResultSurface" Property="BorderBrush" Value="#707DD3FC" /><Setter TargetName="ResultSurface" Property="BorderThickness" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="MenuSurface" Margin="14" CornerRadius="26" Background="#E6111722" BorderBrush="#35FFFFFF" BorderThickness="1"
          ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,1">
    <Border.RenderTransform><ScaleTransform x:Name="MenuScale" ScaleX="0.965" ScaleY="0.965" /></Border.RenderTransform>
    <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="10" Opacity="0.55" Color="#020617" /></Border.Effect>
    <Grid>
      <controls:AmbientEffect x:Name="MenuEffectsLayer" Opacity="0" IsHitTestVisible="False"
                              AutomationProperties.AutomationId="StartMenuEffects" />
      <Rectangle Fill="#24111722" IsHitTestVisible="False" />
      <Grid x:Name="MenuContent" Margin="24" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="MenuContentOffset" Y="12" /></Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

      <Grid>
        <Border Height="50" Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="15">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#AFC5D8"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                     Foreground="#F8FAFC" CaretBrush="#7DD3FC" FontSize="16" VerticalContentAlignment="Center"
                     Padding="0,0,12,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                     AutomationProperties.AutomationId="StartMenuSearch" />
            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search apps, settings, files, and the web" Foreground="#718196" FontSize="16"
                       VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </Grid>

      <DockPanel Grid.Row="1" Margin="4,22,4,12" LastChildFill="False">
        <TextBlock x:Name="SectionTitle" Text="APPS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MenuMuted}" />
        <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource MenuMuted}" />
      </DockPanel>

      <Grid Grid.Row="2">
        <ListBox x:Name="AppResults" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                 ItemContainerStyle="{StaticResource SearchResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonUp="AppResults_PreviewMouseLeftButtonUp"
                 AutomationProperties.AutomationId="StartMenuResults">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="48" AutomationProperties.Name="{Binding Name}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" VerticalAlignment="Center">
                  <Border x:Name="FallbackIcon" CornerRadius="9" Background="#1FFFFFFF" Visibility="Collapsed">
                    <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AFC5D8" />
                  </Border>
                  <Image x:Name="AppIcon" Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MenuMuted}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Kind}" Foreground="#AFC5D8" FontSize="9" FontWeight="SemiBold" />
                </Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="AppIcon" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" /></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#64748B" HorizontalAlignment="Center" />
          <TextBlock Text="No matching results" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" />
          <TextBlock Text="Try a shorter search" Foreground="{StaticResource MenuMuted}" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>

        <Border Grid.Row="3" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,14,0,0">
          <DockPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="34" Height="34" CornerRadius="11" Background="#267DD3FC">
                <TextBlock Text="E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Your apps" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="GlassBar launcher" Foreground="{StaticResource MenuMuted}" FontSize="10" />
              </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource MenuAction}" Click="Documents_Click" ToolTip="Documents" FontFamily="Segoe MDL2 Assets" FontSize="17" Content="&#xE8A5;" />
              <Button Style="{StaticResource MenuAction}" Click="Settings_Click" ToolTip="Windows Settings" FontFamily="Segoe MDL2 Assets" FontSize="17" Content="&#xE713;" />
              <Button Style="{StaticResource MenuAction}" Click="Lock_Click" ToolTip="Lock" FontFamily="Segoe MDL2 Assets" FontSize="17" Content="&#xE72E;" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
