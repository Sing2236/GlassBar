              <TextBlock Text="HIGHLIGHT" Margin="0,10,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Button Style="{StaticResource AccentSwatch}" Background="#7DD3FC" Tag="#7DD3FC" CommandParameter="Accent" Click="SearchPaletteColor_Click" ToolTip="Sky" />
                <Button Style="{StaticResource AccentSwatch}" Background="#A78BFA" Tag="#A78BFA" CommandParameter="Accent" Click="SearchPaletteColor_Click" ToolTip="Violet" />
                <Button Style="{StaticResource AccentSwatch}" Background="#34D399" Tag="#34D399" CommandParameter="Accent" Click="SearchPaletteColor_Click" ToolTip="Mint" />
                <Button Style="{StaticResource AccentSwatch}" Background="#FB7185" Tag="#FB7185" CommandParameter="Accent" Click="SearchPaletteColor_Click" ToolTip="Rose" />
                <Button Style="{StaticResource AccentSwatch}" Background="#FBBF24" Tag="#FBBF24" CommandParameter="Accent" Click="SearchPaletteColor_Click" ToolTip="Amber" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="GlassBar Alt + Tab" FontWeight="SemiBold" /><TextBlock Text="Animated visual window switcher" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <CheckBox x:Name="AltTabEnabledCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center"
                      Click="AltTabEnabledCheck_Click" AutomationProperties.AutomationId="AltTabEnabled" />
          </Grid>
          <Border x:Name="AltTabOptionsPanel" Margin="0,12,0,0" Padding="13" CornerRadius="14"
                  Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="SWITCHER SIZE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
              <WrapPanel Margin="0,8,0,12">
                <Button Style="{StaticResource ChoiceButton}" Content="Compact" Tag="Compact" Click="AltTabLayout_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Full screen" Tag="Fullscreen" Click="AltTabLayout_Click" />
              </WrapPanel>
              <TextBlock Text="SWITCHER BACKGROUND" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
              <WrapPanel Margin="0,8,0,4">
                <Button Style="{StaticResource ChoiceButton}" Content="Glass" Tag="Glass" Click="AltTabBackground_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Dark" Tag="Dark" Click="AltTabBackground_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Transparent" Tag="Transparent" Click="AltTabBackground_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Choose image" Click="ChooseAltTabBackground_Click" />
              </WrapPanel>
              <TextBlock x:Name="AltTabBackgroundImageText" Margin="2,2,0,3" Text="No image selected"
                         Foreground="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" />
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Background opacity" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="AltTabOpacitySlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.2" Maximum="1"
                        VerticalAlignment="Center" ValueChanged="AltTabOpacitySlider_ValueChanged" AutomationProperties.AutomationId="AltTabOpacity" />
              </Grid>
            </StackPanel>
          </Border>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Hide Windows taskbar" FontWeight="SemiBold" /><TextBlock Text="Restored automatically on exit" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <CheckBox x:Name="HideNativeCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="HideNativeCheck_Click" AutomationProperties.AutomationId="HideNativeTaskbar" />
          </Grid>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Hide in fullscreen games" FontWeight="SemiBold" /><TextBlock Text="Browser videos and media players keep GlassBar visible" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <CheckBox x:Name="HideInFullscreenCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="HideInFullscreenCheck_Click" AutomationProperties.AutomationId="HideInFullscreenApps" />
          </Grid>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold" /><TextBlock Text="Launch when you sign in" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="StartWithWindowsCheck_Click" AutomationProperties.AutomationId="StartWithWindows" />
          </Grid>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Group stacked icons" FontWeight="SemiBold" /><TextBlock Text="Multiple windows of the same app share one icon; click to fan them out" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" /></StackPanel>
            <CheckBox x:Name="GroupStackedIconsCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="GroupStackedIconsCheck_Click" AutomationProperties.AutomationId="GroupStackedIcons" />
          </Grid>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Notification badges" FontWeight="SemiBold" /><TextBlock Text="Show a count on an icon when it has notifications (requires Windows notification access)" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" /></StackPanel>
            <CheckBox x:Name="ShowNotificationBadgesCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="ShowNotificationBadgesCheck_Click" AutomationProperties.AutomationId="ShowNotificationBadges" />
          </Grid>

          <DockPanel Margin="0,22,0,0">
            <Button Style="{StaticResource ChoiceButton}" Content="Exit GlassBar" Click="Exit_Click" AutomationProperties.AutomationId="ExitGlassBar" />
            <TextBlock DockPanel.Dock="Right" Text="Ctrl + Alt + Shift + T" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedText}" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border x:Name="BackgroundProcessesPanel" Grid.Row="0" Width="342" Height="312"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,12" Padding="14"
            Visibility="Collapsed" CornerRadius="18" Background="#F2111722"
            BorderBrush="#30FFFFFF" BorderThickness="1"
            AutomationProperties.AutomationId="BackgroundProcessesPanel">
      <Border.Effect><DropShadowEffect BlurRadius="26" Opacity="0.46" ShadowDepth="7" Color="#020617" /></Border.Effect>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,10">
          <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Width="28" MinWidth="28" Height="28" Padding="0"
                  Click="RefreshBackgroundProcesses_Click" ToolTip="Refresh" AutomationProperties.AutomationId="RefreshBackgroundProcesses">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12" />
          </Button>
          <StackPanel>
            <TextBlock Text="Background activity" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="BackgroundProcessCountText" Text="Loading…" Foreground="{StaticResource MutedText}" FontSize="10" />
          </StackPanel>
        </DockPanel>
        <ListBox x:Name="BackgroundProcessesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="BackgroundProcessesList">
          <ListBox.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" />
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="#0BFFFFFF" CornerRadius="10" Padding="9,6">
                      <ContentPresenter />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.Resources>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="34">
                <Grid.ContextMenu>
                  <ContextMenu Style="{StaticResource GlassContextMenu}">
                    <MenuItem Header="Close process" Click="CloseBackgroundProcess_Click" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                  <Border Background="#18FFFFFF" CornerRadius="6" />
                  <TextBlock x:Name="ProcessFallback" Visibility="Collapsed" Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" Foreground="#8FA2B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                  <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Foreground="#B8C5D6" FontSize="9" />
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="ProcessFallback" Property="Visibility" Value="Visible" /></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Margin="2,8,2,0" Text="Grouped by app  ·  highest memory first"
                   Foreground="#72849A" FontSize="9" />
      </Grid>
    </Border>

    <Border x:Name="BarSurface" Grid.Row="1" Margin="4,0,4,4" CornerRadius="22"
            BorderBrush="#30FFFFFF" BorderThickness="1" Background="{DynamicResource GlassBackground}" ClipToBounds="True">
      <Border.Effect><DropShadowEffect x:Name="BarShadow" BlurRadius="28" Opacity="0.48" ShadowDepth="5" Color="#020617" /></Border.Effect>
      <Grid>
        <controls:AmbientEffect x:Name="EffectsLayer" />
        <Rectangle x:Name="BarHighlight" VerticalAlignment="Top" Height="1" Fill="#70FFFFFF" Opacity="0.28" />
        <Grid x:Name="BarContentGrid" Margin="10,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="LaunchControls" Grid.Column="0" Orientation="Horizontal">
            <TextBlock x:Name="BarDragHandle" Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#68FFFFFF"
                       Width="18" VerticalAlignment="Center" TextAlignment="Center" Cursor="SizeAll" ToolTip="Drag GlassBar"
                       PreviewMouseLeftButtonDown="BarDragHandle_PreviewMouseLeftButtonDown" />
            <Button Style="{StaticResource BarButton}" Click="Start_Click" ToolTip="GlassBar menu" AutomationProperties.AutomationId="StartButton">
              <Grid Width="21" Height="21">
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
              </Grid>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Search_Click" ToolTip="Search apps" FontFamily="Segoe MDL2 Assets" Content="&#xE721;" FontSize="18" AutomationProperties.AutomationId="SearchButton" />
            <Button Style="{StaticResource BarButton}" Click="TaskView_Click" ToolTip="Task view" FontFamily="Segoe MDL2 Assets" Content="&#xE7C4;" FontSize="17" />
          </StackPanel>

          <Border x:Name="BarDivider" Grid.Column="1" Width="1" Margin="7,9,10,9" Background="#28FFFFFF" />

          <StackPanel x:Name="AppControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource BarButton}" Click="Explorer_Click" ToolTip="File Explorer" FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" FontSize="20" />
            <Button Style="{StaticResource BarButton}" Click="Terminal_Click" ToolTip="Terminal" FontFamily="Segoe MDL2 Assets" Content="&#xE756;" FontSize="19" />
            <ItemsControl x:Name="PinnedApps">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource BarButton}" Click="PinnedApp_Click" ToolTip="{Binding DisplayName}" Margin="1,0">
                    <Button.ContextMenu>
                      <ContextMenu Style="{StaticResource GlassContextMenu}"><MenuItem Header="Unpin from GlassBar" Click="UnpinApp_Click" /></ContextMenu>
                    </Button.ContextMenu>
                    <Grid Width="24" Height="28"><TextBlock x:Name="PinnedFallback" Visibility="Collapsed" Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="#D7E4F2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" /><Image Source="{Binding Icon}" Width="23" Height="23" RenderOptions.BitmapScalingMode="HighQuality" /><Ellipse Width="4" Height="4" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" /></Grid>
                  </Button>
                  <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="PinnedFallback" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="RunningApps">
              <ItemsControl.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></ItemsControl.RenderTransform>
              <ItemsControl.RenderTransformOrigin>0.5,1</ItemsControl.RenderTransformOrigin>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <!-- Bound to TaskbarIconGroup (one per icon slot). With "Group Stacked
                   Icons" off, or when an app only has one open window, each group
                   always wraps exactly one window and looks/behaves identically to
                   before this existed. With it on and multiple windows sharing a
                   process, the group renders as a "stack" (layered shadow icons)
                   that fans out into one button per window on click. -->
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="1,0" MouseEnter="RunningAppGroup_MouseEnter" MouseLeave="RunningAppGroup_MouseLeave">
                    <Button x:Name="CollapsedButton" Style="{StaticResource BarButton}" Click="RunningApp_Click"
                            ToolTip="{Binding Primary.Title}" AutomationProperties.Name="{Binding Primary.Title}">
                      <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource GlassContextMenu}">
                          <MenuItem Header="Close window" Click="CloseRunningApp_Click" />
                          <MenuItem Header="Pin to GlassBar" Click="PinRunningApp_Click" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid Width="26" Height="30">
                        <Border x:Name="StackShadow2" Width="23" Height="23" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="5,4,0,0" Background="#2A3648" CornerRadius="4" Visibility="Collapsed" />
                        <Border x:Name="StackShadow1" Width="23" Height="23" VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="3,2,0,0" Background="#374357" CornerRadius="4" Visibility="Collapsed" />
                        <TextBlock x:Name="FallbackIcon" Visibility="Collapsed" Text="&#xECAA;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#8FA2B8" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="18" />
                        <Image Source="{Binding Primary.Icon}" Width="23" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Ellipse Width="4" Height="4" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Bottom" Fill="#73839B">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Fill" Value="#73839B" />
                              <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                        <Border Background="#E5484D" CornerRadius="7" MinWidth="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-4,0" Padding="3,0" Visibility="{Binding NotificationCount, Converter={StaticResource PositiveCountToVisibility}}">
                          <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="9" FontWeight="Bold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Button>

                    <!-- Fanned-out state: one small button per window in the group,
                         separated from the collapsed stack with a scale+fade reveal. -->
                    <StackPanel x:Name="ExpandedPanel" Orientation="Horizontal" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0,0.5">
                      <StackPanel.RenderTransform><ScaleTransform ScaleX="0.6" ScaleY="1" /></StackPanel.RenderTransform>
                      <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Style="{StaticResource BarButton}" Click="RunningApp_Click" ToolTip="{Binding Title}" Margin="1,0"
                                    MouseEnter="RunningWindow_MouseEnter" MouseLeave="RunningIcon_MouseLeave"
                                    AutomationProperties.Name="{Binding Title}">
                              <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource GlassContextMenu}">
                                  <MenuItem Header="Close window" Click="CloseFannedWindow_Click" />
                                  <MenuItem Header="Pin to GlassBar" Click="PinFannedWindow_Click" />
                                </ContextMenu>
                              </Button.ContextMenu>
                              <Grid Width="24" Height="30">
                                <TextBlock Visibility="Collapsed" Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" Foreground="#8FA2B8"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="18" />
                                <Image Source="{Binding Icon}" Width="23" Height="23" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Background="#E5484D" CornerRadius="7" MinWidth="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-4,-4,0" Padding="3,0" Visibility="{Binding NotificationCount, Converter={StaticResource PositiveCountToVisibility}}">
                                  <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="9" FontWeight="Bold"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Ellipse Width="4" Height="4" VerticalAlignment="Bottom" Fill="#73839B">
                                  <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                      <Setter Property="Fill" Value="#73839B" />
                                      <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                  </Ellipse.Style>
                                </Ellipse>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Primary.Icon}" Value="{x:Null}">
                      <Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStacked}" Value="True">
                      <Setter TargetName="StackShadow1" Property="Visibility" Value="Visible" />
                      <Setter TargetName="StackShadow2" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                      <Setter TargetName="CollapsedButton" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="ExpandedPanel" Property="Visibility" Value="Visible" />
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ExpandedPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="ExpandedPanel"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.18">
                              <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="AppPager" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
              <Button Style="{StaticResource TinyButton}" Width="24" MinWidth="24" Padding="0" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Click="PreviousAppsPage_Click" ToolTip="Previous apps" AutomationProperties.AutomationId="PreviousAppsPage" />
              <TextBlock x:Name="AppPageText" Text="1/1" Foreground="#AFC0D4" FontSize="9" VerticalAlignment="Center" Margin="2,0" />
              <Button Style="{StaticResource TinyButton}" Width="24" MinWidth="24" Padding="0" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Click="NextAppsPage_Click" ToolTip="Next apps" AutomationProperties.AutomationId="NextAppsPage" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="SystemControls" Grid.Column="3" Orientation="Horizontal">
            <Button Style="{StaticResource TinyButton}" Width="28" MinWidth="28" Height="28" Padding="0"
                    Click="BackgroundProcesses_Click" ToolTip="Background processes" AutomationProperties.AutomationId="BackgroundProcessesButton">
              <Path Width="11" Height="7" Stretch="Fill" Stroke="#E8EEF7" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 1,6 L 5.5,1.5 L 10,6" />
            </Button>
            <Button Style="{StaticResource TinyButton}" Click="QuickSettings_Click" ToolTip="Quick settings" FontFamily="Segoe MDL2 Assets" Content="&#xE9CE;" />
            <Button Style="{StaticResource TinyButton}" Click="QuickSettings_Click" ToolTip="Volume and network" FontFamily="Segoe MDL2 Assets" Content="&#xE767;" />
            <Button Style="{StaticResource BarButton}" Click="Clock_Click" ToolTip="Calendar and notifications" Padding="9,3">
              <StackPanel>
                <TextBlock x:Name="ClockText" Text="9:41" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                <TextBlock x:Name="DateText" Text="SEP 13" Foreground="{StaticResource MutedText}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource TinyButton}" Click="Settings_Click" ToolTip="Customize GlassBar" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" AutomationProperties.AutomationId="SettingsButton" />
          </StackPanel>
        </Grid>
        <Canvas x:Name="StickerCanvas" Background="Transparent" IsHitTestVisible="False" />
      </Grid>
    </Border>

    <!-- Hover preview for taskbar icons (collapsed groups and individual
         fanned-out windows). See RunningApps DataTemplate for the
         MouseEnter/MouseLeave wiring and MainWindow.xaml.cs for
         ShowIconPreview/HideIconPreview. -->
    <Popup x:Name="IconPreviewPopup" Placement="Top" AllowsTransparency="True" IsHitTestVisible="False" PopupAnimation="Fade">
      <Border Background="#1C2534" BorderBrush="#3A4A63" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,8">
        <StackPanel>
          <Image x:Name="IconPreviewImage" Width="144" Height="224" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock x:Name="IconPreviewTitle" Foreground="#D7E4F2" FontSize="10" Margin="2,4,2,0" MaxWidth="150" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
