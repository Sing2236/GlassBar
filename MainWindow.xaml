<Window x:Class="GlassBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GlassBar.Controls"
        Title="GlassBar" Width="1080" Height="78"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AutomationProperties.AutomationId="GlassBarMainWindow"
        FontFamily="{StaticResource UiFont}" Foreground="#F8FAFC">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedText" Color="#A8B4C6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="GlassBackground" Color="#111722" Opacity="0.82" />
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="13"
                    BorderBrush="#20FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#20FFFFFF" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#36FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#36FFFFFF" />
                <Setter TargetName="Surface" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                </Setter>
                <Setter TargetName="Surface" Property="RenderTransformOrigin" Value="0.5,0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="ChoiceButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E8EEF7" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#20FFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentSwatch" TargetType="Button">
      <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,9,0" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="#32FFFFFF" BorderThickness="1">
              <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.25" /></Border.Effect>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="BorderBrush" Value="#BFFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.72" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GlassSlider" TargetType="Slider">
      <Setter Property="Height" Value="28" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="28">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#324155" CornerRadius="2" /></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F1F7FC" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" /></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GlassToggle" TargetType="CheckBox">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="24" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="ToggleTrack" Width="44" Height="24" CornerRadius="12" Background="#334155" BorderBrush="#38FFFFFF" BorderThickness="1">
              <Ellipse x:Name="ToggleKnob" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Fill="#DCE7F2" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="ToggleKnob" Property="Fill" Value="#0F1722" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleTrack" Property="Opacity" Value="0.86" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GlassTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#24FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,8" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="TextBoxSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StickerPickerItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#C9D6E5" />
      <Setter Property="Margin" Value="0,0,7,7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="StickerChoice" Padding="{TemplateBinding Padding}" CornerRadius="9"
                    Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StickerChoice" Property="Background" Value="#20FFFFFF" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="StickerChoice" Property="Background" Value="#251EC8F0" />
                <Setter TargetName="StickerChoice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="#F8FAFC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GlassScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="7" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#62758B" CornerRadius="4" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="WindowRoot" Background="Transparent" PreviewMouseLeftButtonDown="WindowRoot_PreviewMouseLeftButtonDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition x:Name="BarRow" Height="68" />
    </Grid.RowDefinitions>

    <Border x:Name="SettingsPanel" Grid.Row="0" Width="470" HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Margin="0,8,8,12" Padding="22" Visibility="Collapsed" CornerRadius="22"
            Background="#ED111722" BorderBrush="#28FFFFFF" BorderThickness="1"
            AutomationProperties.AutomationId="SettingsPanel">
      <Border.Effect><DropShadowEffect BlurRadius="28" Opacity="0.42" ShadowDepth="8" Color="#000000" /></Border.Effect>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}" /></ScrollViewer.Resources>
        <StackPanel>
          <DockPanel>
            <StackPanel>
              <TextBlock Text="Customize GlassBar" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Changes are saved as you make them." Foreground="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource TinyButton}" Width="30" MinWidth="30" Height="30" Padding="0"
                    FontSize="11" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    Click="CloseSettings_Click" ToolTip="Close settings" AutomationProperties.AutomationId="CloseSettings" />
          </DockPanel>

          <StackPanel Margin="0,22,0,0">
            <TextBlock Text="AMBIENT EFFECT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
            <WrapPanel Margin="0,9,0,0">
              <Button Style="{StaticResource ChoiceButton}" Content="Rain" Tag="Rain" Click="Effect_Click" AutomationProperties.AutomationId="EffectRain" />
              <Button Style="{StaticResource ChoiceButton}" Content="Aurora" Tag="Aurora" Click="Effect_Click" AutomationProperties.AutomationId="EffectAurora" />
              <Button Style="{StaticResource ChoiceButton}" Content="Snow" Tag="Snow" Click="Effect_Click" AutomationProperties.AutomationId="EffectSnow" />
              <Button Style="{StaticResource ChoiceButton}" Content="Fireflies" Tag="Fireflies" Click="Effect_Click" AutomationProperties.AutomationId="EffectFireflies" />
              <Button Style="{StaticResource ChoiceButton}" Content="Pulse" Tag="Pulse" Click="Effect_Click" AutomationProperties.AutomationId="EffectPulse" />
              <Button Style="{StaticResource ChoiceButton}" Content="Custom" Tag="Custom" Click="Effect_Click" AutomationProperties.AutomationId="EffectCustom" />
              <Button Style="{StaticResource ChoiceButton}" Content="Off" Tag="Off" Click="Effect_Click" AutomationProperties.AutomationId="EffectOff" />
            </WrapPanel>
          </StackPanel>

          <Border x:Name="CustomEffectPanel" Margin="0,14,0,0" Padding="14" CornerRadius="14" Visibility="Collapsed"
                  Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                  AutomationProperties.AutomationId="CustomEffectPanel">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChoiceButton}" Margin="12,0,0,8"
                        Content="Randomize" Click="RandomizeEffect_Click" AutomationProperties.AutomationId="RandomizeEffect" />
                <StackPanel>
                  <TextBlock Text="Custom effect lab" FontWeight="SemiBold" />
                  <TextBlock x:Name="CustomEffectSummary" Text="Orb · Float" Foreground="{StaticResource MutedText}" FontSize="11" />
                </StackPanel>
              </DockPanel>

              <TextBox x:Name="CustomEffectNameBox" Style="{StaticResource GlassTextBox}" Margin="0,12,0,0" MaxLength="40"
                       TextChanged="CustomEffectNameBox_TextChanged" AutomationProperties.AutomationId="CustomEffectName" />

              <TextBlock Text="PARTICLE SHAPE" Margin="0,13,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
              <WrapPanel Margin="0,7,0,0">
                <Button Style="{StaticResource ChoiceButton}" Content="Orb" Tag="Orb" Click="CustomShape_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Spark" Tag="Spark" Click="CustomShape_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Drop" Tag="Drop" Click="CustomShape_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Diamond" Tag="Diamond" Click="CustomShape_Click" />
              </WrapPanel>

              <TextBlock Text="MOTION" Margin="0,8,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
              <WrapPanel Margin="0,7,0,0">
                <Button Style="{StaticResource ChoiceButton}" Content="Float" Tag="Float" Click="CustomMotion_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Fall" Tag="Fall" Click="CustomMotion_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Rise" Tag="Rise" Click="CustomMotion_Click" />
                <Button Style="{StaticResource ChoiceButton}" Content="Drift" Tag="Drift" Click="CustomMotion_Click" />
              </WrapPanel>

              <TextBlock Text="SECONDARY COLOR" Margin="0,8,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Button Style="{StaticResource AccentSwatch}" Background="#A78BFA" Tag="#A78BFA" Click="CustomColor_Click" ToolTip="Violet" />
                <Button Style="{StaticResource AccentSwatch}" Background="#34D399" Tag="#34D399" Click="CustomColor_Click" ToolTip="Mint" />
                <Button Style="{StaticResource AccentSwatch}" Background="#FB7185" Tag="#FB7185" Click="CustomColor_Click" ToolTip="Rose" />
                <Button Style="{StaticResource AccentSwatch}" Background="#FBBF24" Tag="#FBBF24" Click="CustomColor_Click" ToolTip="Amber" />
              </StackPanel>

              <Grid Margin="0,11,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Density" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="CustomDensitySlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.2" Maximum="1" ValueChanged="CustomDensitySlider_ValueChanged" AutomationProperties.AutomationId="CustomDensity" />
              </Grid>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Speed" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="CustomSpeedSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.1" Maximum="1" ValueChanged="CustomSpeedSlider_ValueChanged" AutomationProperties.AutomationId="CustomSpeed" />
              </Grid>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Particle size" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="CustomSizeSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.1" Maximum="1" ValueChanged="CustomSizeSlider_ValueChanged" AutomationProperties.AutomationId="CustomParticleSize" />
              </Grid>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Glow" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="CustomGlowSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="CustomGlowSlider_ValueChanged" AutomationProperties.AutomationId="CustomGlow" />
              </Grid>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Trail" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="CustomTrailSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="CustomTrailSlider_ValueChanged" AutomationProperties.AutomationId="CustomTrail" />
              </Grid>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                <Button Style="{StaticResource ChoiceButton}" Content="Import JSON" Click="ImportEffect_Click" AutomationProperties.AutomationId="ImportEffect" />
                <Button Style="{StaticResource ChoiceButton}" Content="Export JSON" Click="ExportEffect_Click" AutomationProperties.AutomationId="ExportEffect" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Margin="0,18,0,0">
            <TextBlock Text="ACCENT COLOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <Button Style="{StaticResource AccentSwatch}" Background="#7DD3FC" Tag="#7DD3FC" Click="Accent_Click" ToolTip="Sky" />
              <Button Style="{StaticResource AccentSwatch}" Background="#A78BFA" Tag="#A78BFA" Click="Accent_Click" ToolTip="Violet" />
              <Button Style="{StaticResource AccentSwatch}" Background="#34D399" Tag="#34D399" Click="Accent_Click" ToolTip="Mint" />
              <Button Style="{StaticResource AccentSwatch}" Background="#FB7185" Tag="#FB7185" Click="Accent_Click" ToolTip="Rose" />
              <Button Style="{StaticResource AccentSwatch}" Background="#FBBF24" Tag="#FBBF24" Click="Accent_Click" ToolTip="Amber" />
            </StackPanel>
          </StackPanel>

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Glass opacity" FontWeight="SemiBold" /><TextBlock Text="Background transparency" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <Slider x:Name="OpacitySlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.30" Maximum="0.98" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.AutomationId="OpacitySlider" />
          </Grid>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Effect intensity" FontWeight="SemiBold" /><TextBlock Text="Animation strength" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <Slider x:Name="IntensitySlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.15" Maximum="1" VerticalAlignment="Center" ValueChanged="IntensitySlider_ValueChanged" AutomationProperties.AutomationId="IntensitySlider" />
          </Grid>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Bar width" FontWeight="SemiBold" /><TextBlock x:Name="WidthValueText" Text="980 px" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <Slider x:Name="WidthSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="720" Maximum="1600" TickFrequency="20" VerticalAlignment="Center" ValueChanged="WidthSlider_ValueChanged" AutomationProperties.AutomationId="WidthSlider" />
          </Grid>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Bar height" FontWeight="SemiBold" /><TextBlock Text="Compact or roomy" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <Slider x:Name="HeightSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="60" Maximum="82" TickFrequency="2" VerticalAlignment="Center" ValueChanged="HeightSlider_ValueChanged" AutomationProperties.AutomationId="HeightSlider" />
          </Grid>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Corner radius" FontWeight="SemiBold" /><TextBlock Text="Square to pill shaped" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <Slider x:Name="CornerSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="10" Maximum="32" TickFrequency="2" VerticalAlignment="Center" ValueChanged="CornerSlider_ValueChanged" AutomationProperties.AutomationId="CornerSlider" />
          </Grid>

          <Border Margin="0,20,0,0" Padding="14" CornerRadius="14" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
            <StackPanel>
              <StackPanel>
                <TextBlock Text="GIF stickers" FontWeight="SemiBold" />
                <TextBlock Text="Add one, then drag it anywhere on the bar" Foreground="{StaticResource MutedText}" FontSize="11" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                  <Button Style="{StaticResource ChoiceButton}" Content="Add GIF" Click="AddSticker_Click" AutomationProperties.AutomationId="AddSticker" />
                  <Button Style="{StaticResource ChoiceButton}" Content="Clear" Click="ClearStickers_Click" AutomationProperties.AutomationId="ClearStickers" />
                </StackPanel>
              </StackPanel>
              <ListBox x:Name="StickerPicker" Margin="0,13,0,0" Background="Transparent" BorderThickness="0"
                       ItemContainerStyle="{StaticResource StickerPickerItem}" SelectionChanged="StickerPicker_SelectionChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="StickerPicker">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" MaxWidth="112" TextTrimming="CharacterEllipsis" FontSize="11" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="0,13,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Selected size" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="StickerSizeSlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="24" Maximum="110" ValueChanged="StickerSizeSlider_ValueChanged" AutomationProperties.AutomationId="StickerSizeSlider" />
              </Grid>
              <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /></Grid.ColumnDefinitions>
                <TextBlock Text="Selected opacity" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="11" />
                <Slider x:Name="StickerOpacitySlider" Style="{StaticResource GlassSlider}" Grid.Column="1" Minimum="0.15" Maximum="1" ValueChanged="StickerOpacitySlider_ValueChanged" AutomationProperties.AutomationId="StickerOpacitySlider" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,19,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Hide Windows taskbar" FontWeight="SemiBold" /><TextBlock Text="Restored automatically on exit" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <CheckBox x:Name="HideNativeCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="HideNativeCheck_Click" AutomationProperties.AutomationId="HideNativeTaskbar" />
          </Grid>
          <Grid Margin="0,17,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold" /><TextBlock Text="Launch when you sign in" Foreground="{StaticResource MutedText}" FontSize="11" /></StackPanel>
            <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource GlassToggle}" Grid.Column="1" VerticalAlignment="Center" Click="StartWithWindowsCheck_Click" AutomationProperties.AutomationId="StartWithWindows" />
          </Grid>

          <DockPanel Margin="0,22,0,0">
            <Button Style="{StaticResource ChoiceButton}" Content="Exit GlassBar" Click="Exit_Click" AutomationProperties.AutomationId="ExitGlassBar" />
            <TextBlock DockPanel.Dock="Right" Text="Ctrl + Alt + Shift + T" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedText}" />
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border x:Name="BarSurface" Grid.Row="1" Margin="4,0,4,4" CornerRadius="22"
            BorderBrush="#30FFFFFF" BorderThickness="1" Background="{DynamicResource GlassBackground}" ClipToBounds="True">
      <Border.Effect><DropShadowEffect BlurRadius="28" Opacity="0.48" ShadowDepth="5" Color="#020617" /></Border.Effect>
      <Grid>
        <controls:AmbientEffect x:Name="EffectsLayer" />
        <Rectangle VerticalAlignment="Top" Height="1" Fill="#70FFFFFF" Opacity="0.28" />
        <Grid Margin="10,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Style="{StaticResource BarButton}" Click="Start_Click" ToolTip="GlassBar menu" AutomationProperties.AutomationId="StartButton">
              <Grid Width="21" Height="21">
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" RadiusX="1.5" />
              </Grid>
            </Button>
            <Button Style="{StaticResource BarButton}" Click="Search_Click" ToolTip="Search apps" FontFamily="Segoe MDL2 Assets" Content="&#xE721;" FontSize="18" AutomationProperties.AutomationId="SearchButton" />
            <Button Style="{StaticResource BarButton}" Click="TaskView_Click" ToolTip="Task view" FontFamily="Segoe MDL2 Assets" Content="&#xE7C4;" FontSize="17" />
          </StackPanel>

          <Border Grid.Column="1" Width="1" Margin="7,9,10,9" Background="#28FFFFFF" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource BarButton}" Click="Explorer_Click" ToolTip="File Explorer" FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" FontSize="20" />
            <Button Style="{StaticResource BarButton}" Click="Terminal_Click" ToolTip="Terminal" FontFamily="Segoe MDL2 Assets" Content="&#xE756;" FontSize="19" />
            <ItemsControl x:Name="RunningApps">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource BarButton}" Click="RunningApp_Click" ToolTip="{Binding Title}" Margin="1,0">
                    <Grid Width="24" Height="30">
                      <TextBlock x:Name="FallbackIcon" Visibility="Collapsed" Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" Foreground="#8FA2B8" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="18" />
                      <Image Source="{Binding Icon}" Width="23" Height="23" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                      <Ellipse Width="4" Height="4" VerticalAlignment="Bottom" Fill="#73839B">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#73839B" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                    </Grid>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                      <Setter TargetName="FallbackIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button Style="{StaticResource TinyButton}" Click="QuickSettings_Click" ToolTip="Quick settings" FontFamily="Segoe MDL2 Assets" Content="&#xE9CE;" />
            <Button Style="{StaticResource TinyButton}" Click="QuickSettings_Click" ToolTip="Volume and network" FontFamily="Segoe MDL2 Assets" Content="&#xE767;" />
            <Button Style="{StaticResource BarButton}" Click="Clock_Click" ToolTip="Calendar and notifications" Padding="9,3">
              <StackPanel>
                <TextBlock x:Name="ClockText" Text="9:41" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                <TextBlock x:Name="DateText" Text="SEP 13" Foreground="{StaticResource MutedText}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource TinyButton}" Click="Settings_Click" ToolTip="Customize GlassBar" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" AutomationProperties.AutomationId="SettingsButton" />
          </StackPanel>
        </Grid>
        <Canvas x:Name="StickerCanvas" Background="Transparent" IsHitTestVisible="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
