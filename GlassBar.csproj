<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-versioned TFM (instead of plain net8.0-windows) needed for the
         WinRT projection of Windows.UI.Notifications.Management.UserNotificationListener,
         used by NotificationBadgeService for the per-icon notification count badges. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GlassBar</AssemblyName>
    <RootNamespace>GlassBar</RootNamespace>
    <Version>1.0.2</Version>
    <InformationalVersion>1.0.2</InformationalVersion>
    <Authors>Ethan Huynh</Authors>
    <Product>GlassBar</Product>
    <Description>A customizable transparent taskbar for Windows.</Description>
    <ApplicationIcon>assets\GlassBar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Include="assets\license-public.pem" LogicalName="GlassBar.LicensePublicKey" />
    <EmbeddedResource Include="assets\update-public.pem" LogicalName="GlassBar.UpdatePublicKey" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
  </ItemGroup>
</Project>
