<Window x:Class="GlassBar.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBar update" Width="410" Height="238"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}"
        Foreground="#F3F7FB" Loaded="Window_Loaded" KeyDown="Window_KeyDown"
        AutomationProperties.AutomationId="GlassBarUpdatePrompt">
  <Window.Resources>
    <Style x:Key="PromptButton" TargetType="Button">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="#EAF2FA" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#28FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.86" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7DD3FC" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryPromptButton" TargetType="Button" BasedOn="{StaticResource PromptButton}">
      <Setter Property="Foreground" Value="#071019" />
      <Setter Property="Background" Value="#7DD3FC" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>
  </Window.Resources>

  <Border x:Name="PromptSurface" Margin="12" Padding="20" CornerRadius="18"
          Background="#F4111722" BorderBrush="#35FFFFFF" BorderThickness="1"
          Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="PromptScale" ScaleX="0.97" ScaleY="0.97" /></Border.RenderTransform>
    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#020617" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel>
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="30" Height="30" Background="Transparent"
                BorderThickness="0" Foreground="#AFC0D2" Cursor="Hand" Click="NotNow_Click" ToolTip="Not now"
                AutomationProperties.Name="Close update prompt">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="11" />
        </Button>
        <TextBlock Text="UPDATE AVAILABLE" FontSize="10" FontWeight="SemiBold" Foreground="#9BAABD" VerticalAlignment="Center" />
      </DockPanel>

      <StackPanel Grid.Row="1" Margin="0,13,0,12">
        <TextBlock x:Name="TitleText" Text="Update to GlassBar" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" Margin="0,7,6,0" Foreground="#B7C5D5" FontSize="11" TextWrapping="Wrap"
                   Text="Install the update now and GlassBar will restart automatically, or keep working and decide later." />
        <ProgressBar x:Name="DownloadProgress" Height="3" Margin="0,14,0,0" IsIndeterminate="True"
                     Foreground="#7DD3FC" Background="#24FFFFFF" Visibility="Collapsed" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="NotNowButton" Style="{StaticResource PromptButton}" Content="Not now" Click="NotNow_Click"
                AutomationProperties.AutomationId="UpdateNotNow" />
        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryPromptButton}" Content="Update now" Click="UpdateNow_Click"
                AutomationProperties.AutomationId="UpdateNow" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
